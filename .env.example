# AI Job Hunter — Environment Variables
# Copy this file to .env and fill in your values
# cp .env.example .env

# ─────────────────────────────────────────
# OpenAI Configuration
# ─────────────────────────────────────────

# Your OpenAI API key (required when OPENAI_MOCK_MODE=false)
# Get one at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Which OpenAI model to use for AI features
# Recommended: gpt-4o-mini (fast + affordable)
# Alternatives: gpt-4o, gpt-4-turbo
OPENAI_MODEL=gpt-4o-mini

# Set to true to use mock AI responses (no API key needed)
# Perfect for development and demos
# Set to false to use real OpenAI calls
OPENAI_MOCK_MODE=true

# ─────────────────────────────────────────
# Application Security
# ─────────────────────────────────────────

# Secret key for signing session cookies
# IMPORTANT: Change this to a long random string in production
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string-in-production
